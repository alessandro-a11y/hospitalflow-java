# HospitalFlow - Variáveis de ambiente de exemplo
# Copie este arquivo para .env e preencha com valores reais do ambiente local.
# NÃO commite o arquivo .env (ele está no .gitignore).

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/hospitalflow
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui

# Porta da aplicação
SERVER_PORT=8080

# Origem do frontend (CORS) - ajuste para a URL do frontend em desenvolvimento
FRONTEND_ORIGIN=http://localhost:5173

# Nível de logging
LOGGING_LEVEL_COM_HOSPITALFLOW_BACKEND=DEBUG
